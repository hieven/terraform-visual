{
  "name": "@terraform-visual/cli",
  "description": "Terraform Visual cli",
  "version": "0.2.1",
  "main": "dist/index.js",
  "bin": {
    "terraform-visual": "bin/index.js"
  },
  "scripts": {
    "build": "npm run build:template && npm run build:cli",
    "build:cli": "rm -rf dist && tsc",
    "dev:cli": "tsx src/index.ts",
    "build:template": "rm -rf template/.next template/dist && npm --prefix template run build",
    "dev:template": "npm --prefix template run dev"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^16.9.43",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hieven/terraform-visual"
  },
  "homepage": "https://hieven.github.io/terraform-visual/",
  "license": "MIT",
  "keywords": [
    "terraform",
    "terraform-visual",
    "terraform-graph",
    "terraform-plan",
    "plan",
    "cli",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
